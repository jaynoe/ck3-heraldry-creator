{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://awoiaf.westeros.org/*"
        },
        {
          "url": "https://github.com/jaynoe/ck3-heraldry-creator/issues/new*"
        },
        {
          "url": "https://github.com/jaynoe/ck3-heraldry-creator/releases/*"
        }
      ]
    },
    "updater:default",
    "process:allow-restart"
  ]
}
