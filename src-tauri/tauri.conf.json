{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Heraldry Creator",
  "version": "0.1.2",
  "identifier": "app.heraldrycreator",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Heraldry Creator",
        "width": 1280,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true,
    "category": "Game",
    "shortDescription": "Coats of arms, house names and words for CK3 with the AGOT mod"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCNUNCREMyMjBCOEEyN0MKUldSOG9yZ2d3cjFjVzc2ekFQREtSMDNUampKRTduUitjbnE4NVhubWM0UTk1ZExlL3A2MDlORVAK",
      "endpoints": [
        "https://github.com/jaynoe/ck3-heraldry-creator/releases/latest/download/latest.json"
      ]
    }
  }
}
